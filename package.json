{
  "author": "Felipe Rohde <feliperohdee@gmail.com>",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fortawesome/fontawesome-free": "^6.1.2",
    "@types/pixelmatch": "^5.2.4",
    "@vitest/browser": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "prettier": "^2.8.1",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@feliperohdee/html-to-image",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/feliperohdee/html-to-image"
  },
  "scripts": {
    "build": "yarn lint && rm -rf dist && esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --sourcemap && tsc --emitDeclarationOnly --outDir dist",
    "lint": "prettier --write . && eslint 'src/**/*.ts' --fix",
    "npm:publish": "yarn test && yarn build && yarn version --patch --no-git-tag-version && yarn publish --non-interactive",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.0.0"
}
